{
  "name": "supadns-js",
  "version": "1.0.1",
  "description": "Bypass blocked DNS for Supabase using DNS-over-HTTPS. Drop-in replacement for createClient.",

  "main": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/supadns/supadns-js.git"
  },

  "homepage": "https://github.com/supadns/supadns-js#readme",

  "bugs": {
    "url": "https://github.com/supadns/supadns-js/issues"
  },

  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },

  "keywords": [
    "supabase",
    "dns",
    "doh",
    "dns-over-https",
    "bypass",
    "india",
    "blocked",
    "resolver"
  ],

  "license": "MIT",

  "peerDependencies": {
    "@supabase/supabase-js": ">=2.0.0"
  },

  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },

  "engines": {
    "node": ">=18.0.0"
  },

  "files": [
    "dist",
    "README.md"
  ]
}
